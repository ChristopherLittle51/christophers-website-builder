# Required for production. Use a long random value.
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=change-me

# The public HTTPS origin used for Open Graph images and canonical metadata.
SITE_URL=http://localhost:3000

# auto (default) supports direct LAN HTTP and HTTPS proxies via
# X-Forwarded-Proto. Set false only to force non-Secure cookies everywhere.
COOKIE_SECURE=auto

# filesystem (default) or s3
STORAGE_DRIVER=filesystem
DATA_DIR=./data

# Required only when STORAGE_DRIVER=s3. Works with AWS S3, Cloudflare R2,
# MinIO, DigitalOcean Spaces, Backblaze B2, and other S3-compatible stores.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=open-canvas
