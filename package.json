{
  "name": "open-canvas-builder",
  "version": "1.0.0",
  "description": "A self-hostable, mobile-first visual website builder for creative portfolios.",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "import:site": "node scripts/import-site-export.mjs",
