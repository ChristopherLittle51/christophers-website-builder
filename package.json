    "test:embeds": "node --experimental-strip-types --test lib/embed-utils.test.ts",
    "test:github": "node --experimental-strip-types --test lib/github.test.ts",
    "test:media": "node --experimental-strip-types --test lib/media.test.ts",
    "test:metadata": "node --experimental-strip-types --test lib/site-metadata.test.ts",
    "test:puck-data": "node --experimental-strip-types --test lib/puck-data.test.ts",
    "test:site-pages": "node --experimental-strip-types --test lib/site-pages.test.ts",
    "test:analytics": "node --experimental-strip-types --test lib/analytics.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
